# Supabase project: Quorum Prosthetic (pzwsehbrstvjkqpxwyod)
# SERVICE ROLE KEY — server-only, bypasses Row Level Security. NEVER prefix
# with NEXT_PUBLIC_, never import lib/supabaseAdmin.ts from a "use client" file.
# Get it from: Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_URL=https://pzwsehbrstvjkqpxwyod.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Password gate for this internal dashboard (not a Supabase user — a shared
# team password). Pick a long random value.
ADMIN_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Random secret used to sign the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-char-hex-string
